---
import Icon from '@/components/Icon.astro';

interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div
  x-data={`{ 
    modalOpen: true,
    init() {
      this.checkHash();
      window.addEventListener('hashchange', () => this.checkHash());
    },
    checkHash() {
      this.modalOpen = window.location.hash === '#${id}';
    },    
    close() {
      this.modalOpen = false;
      history.pushState('', document.title, window.location.pathname + window.location.search);
    }
  }`}
  @keydown.escape.window="close()"
  @click.outside="close()"
  x-show="modalOpen"
  x-cloak
  x-trap.inert.noscroll="modalOpen"
  x-transition:enter="ease-out duration-300"
  x-transition:enter-start="opacity-0 translate-y-20"
  x-transition:enter-end="opacity-100 translate-y-0"
  x-transition:leave="ease-in duration-200"
  x-transition:leave-start="opacity-100 translate-y-0"
  x-transition:leave-end="opacity-0 translate-y-20"
  class="fixed bottom-0 z-50 px-6 pt-24 text-gray-100 bg-gray-900 md:w-full right-6 md:max-w-110 max-md:left-6 rounded-t-xl md:rounded-t-2xl md:px-12 md:pt-32 pb-11 md:pb-12"
>
  <button
    @click="close()"
    class="absolute top-0 right-0 w-10 h-10 m-8 text-gray-900 bg-gray-100 border border-gray-100 rounded-full cursor-pointer md:m-12 hover:text-gray-100 transition-colors duration-300 hover:bg-gray-900"
  >
    <Icon name="close" className="w-4 h-4" />
  </button>
  <slot />
</div>
