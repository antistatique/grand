---
import Icon from '@/components/Icon.astro';
import { t } from '@/locales';
import { cm } from '@/utils';
const nav = [
  {
    label: t('menu.jury'),
    href: '/',
  },
  {
    label: t('menu.categories'),
    href: '/categories',
  },
  {
    label: t('menu.billetterie-et-inscriptions'),
    href: '/billetterie-et-inscriptions',
  },
  {
    label: t('menu.sponsors'),
    href: '/sponsors',
  },
];
const pathname = Astro.url.pathname;
---

<header
  class="flex items-center justify-between px-6 mx-auto md:px-10 pt-7 max-w-(--container)"
  x-data="{
    open: false,
    mobile: window.innerWidth < 768,
    showLogo: false
  }"
  x-init="
    window.addEventListener('resize', () => mobile = window.innerWidth < 768)
    // Add scroll event listener for rotation
    window.addEventListener('scroll', () => {
      if (showLogo) {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrollProgress = scrollTop / docHeight;
        const rotationDegree = Math.min(30, scrollProgress * 30);
        
        document.documentElement.style.setProperty('--logo-rotation', `${rotationDegree}deg`);
      }
    });
  "
>
  {/* Normal logo */}
  <a href="/" class="relative z-10 block h-auto w-28 md:w-40 shrink-0">
    <img
      x-cloak
      x-show="open && mobile"
      src="/svg/logo-full-light.svg"
      alt="Le GRAND"
    />
    <img
      x-show="!open || !mobile"
      src="/svg/logo-full-dark.svg"
      alt="Le GRAND"
    />
  </a>

  {/* Threshold marker set at 200px from the top  */}
  <div
    x-intersect:leave="showLogo = true"
    x-intersect:enter="showLogo = false; document.documentElement.style.setProperty('--logo-rotation', '0deg')"
    x-intersect:margin="0px 0px -200px 0px"
    class="absolute z-50 w-full h-0 bg-gray-900 top-[200px]"
    aria-hidden="true"
  >
  </div>

  {/* Rotating fixed logo */}
  <a
    href="/"
    x-show="showLogo"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 transform -translate-y-4"
    x-transition:enter-end="opacity-100 transform translate-y-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0 -translate-y-4"
    class="fixed z-50 top-6 left-6 rotate-(--logo-rotation)"
  >
    <img
      src="/svg/logo-g-light.svg"
      alt="Logo"
      class="w-11 h-11 md:w-18 md:h-18"
    />
  </a>

  <button
    class="relative z-10 md:text-gray-900 md:hidden"
    @click="open = !open"
    :class="open ? 'text-gray-100' : 'text-gray-900'"
  >
    <span x-show="!open">{t('menu.toggle_open')}</span>
    <span x-show="open">{t('menu.toggle_close')}</span>
  </button>
  <nav
    class="max-md:fixed max-md:inset-0 max-md:bg-gray-900 max-md:text-gray-100 max-md:px-6 max-md:flex max-md:flex-col max-md:justify-between max-md:pb-8"
    x-show="open || !mobile"
    x-transition.opacity
    x-transition.duration.100ms
  >
    <ul
      class="flex text-2xl md:text-base gap-8 md:gap-6 max-md:flex-col max-md:mt-48"
    >
      {
        nav.map(item => (
          <li class="isolate">
            <a
              href={item.href}
              class={cm(
                'relative pr-3 hover-underline cursor-pointer max-md:w-full inline-block max-md:after:bottom-1/2! max-md:after:translate-y-1/2!',
                pathname.includes(item.href) && 'after:scale-x-100!'
              )}
            >
              <span class="relative z-20 pr-3 max-md:bg-gray-900">
                {item.label}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex flex-col mt-auto gap-3.5 md:hidden">
      <a
        href={t('external_links.projects')}
        class="flex items-center justify-between text-sm text-gray-100 border border-gray-100 rounded-full px-3.5 py-2.5"
      >
        {t('ctas.submit_project')}
        <Icon name="chevron-right" className="w-3 h-3" />
      </a>
      <a
        href={t('external_links.tickets')}
        class="flex items-center justify-between text-sm text-gray-900 bg-gray-100 border border-gray-900 rounded-full px-3.5 py-2.5"
      >
        {t('ctas.buy_ticket')}
        <Icon name="chevron-right" className="w-3 h-3" />
      </a>
    </div>
  </nav>
</header>

<style>
  :root {
    --logo-rotation: 0deg;
  }
</style>
