---
import { cm } from '@/utils';

type Props = {
  name: string;
  className?: string;
};

const { name, className }: Props = Astro.props;
---

<svg
  class={cm(
    'inline-flex self-center justify-center items-center relative top-[-0.1em] w-4 h-4 text-[0.7em] fill-current',
    className
  )}
  aria-hidden="true"
>
  <use xlink:href={`/icons.svg#${name}`}></use>
</svg>
