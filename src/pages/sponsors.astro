---
import CTA from '@/components/CTA.astro';
import Picture from '@/components/Picture.astro';
import Layout from '@/layouts/Layout.astro';
import { t } from '@/locales';
import { cm } from '@/utils';
---

<Layout
  title="Les sponsors du GRAND Prix Romand de la Création 2025"
  description="Un grand merci à nos sponsors pour leur soutien et aide. Award / Prix le GRAND 2025."
>
  <div
    class="px-6 mx-auto max-w-(--container)"
    x-data="{ hash: window.location.hash }"
    x-init="window.addEventListener('hashchange', () => hash = window.location.hash)"
  >
    <section class="flex justify-center">
      <div
        class="w-full md:w-auto grid md:inline-grid md:grid-cols-[min-content] gap-2 mt-30"
      >
        <h1
          class="uppercase md:text-center text-heading-lg md:whitespace-nowrap"
          set:html={t('pages.sponsors.title')}
        />
        <p
          class="relative w-4/5 ml-auto text-paragraph-sm before:content-[''] before:absolute before:right-full before:top-0 before:w-[calc(25%-1rem)] before:mt-[0.6em] before:h-px before:bg-gray-900 before:mr-4"
        >
          {t('pages.sponsors.intro')}
        </p>
      </div>
    </section>

    <section class="mt-30 md:mt-35 grid grid-cols-2 md:grid-cols-5 gap-8">
      {
        (t('pages.sponsors.sponsors') as { slug: string; link: string }[]).map(
          ({ slug, link }, i) => (
            <div
              class={cm(
                'relative flex items-center justify-center py-3',
                'before:absolute before:inset-y-0 before:-right-4 before:border-r-1 before:border-gray-900',
                'after:absolute after:inset-x-0 after:-bottom-4 after:border-b-1 after:border-gray-900',
                i % 5 !== 4
                  ? 'md:before:content-[""]'
                  : 'md:before:content-none',
                i % 2 !== 1
                  ? 'max-md:before:content-[""]'
                  : 'max-md:before:content-none',
                i < 10 ? 'md:after:content-[""]' : 'md:after:content-none',
                i < 10
                  ? 'max-md:after:content-[""]'
                  : 'max-md:after:content-none'
              )}
            >
              <a
                href={link}
                target="_blank"
                class="flex items-center justify-center w-31 h-31"
              >
                <img
                  src={`/svg/sponsor-${slug}.svg`}
                  alt={slug}
                  class="w-full h-auto"
                />
              </a>
            </div>
          )
        )
      }
    </section>
  </div>
</Layout>

<script src="@/modules/embla.ts"></script>
